{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dayoun.dev/contracts/deck-output-receipt.schema.json",
  "title": "Digest-bound assembled slide pixels",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "approvalEnvelopeDigest", "rendererVersion", "slides"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "approvalEnvelopeDigest": { "$ref": "#/$defs/digest" },
    "rendererVersion": { "const": "scene-deck-v1" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fileName", "sha256"],
        "properties": {
          "fileName": { "type": "string", "pattern": "^slide_[0-9]+\\.png$" },
          "sha256": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
