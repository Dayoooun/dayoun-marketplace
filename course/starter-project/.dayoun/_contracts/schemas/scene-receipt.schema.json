{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dayoun.dev/contracts/scene-receipt.schema.json",
  "title": "Digest-bound scene renderer receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptVersion", "approvalEnvelopeDigest", "rendererVersion", "scenes"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "receiptVersion": { "const": "dayoun-scene-render-receipt-v1" },
    "approvalEnvelopeDigest": { "$ref": "#/$defs/digest" },
    "rendererVersion": { "const": "scene-deck-v1" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sceneId", "promptDigest", "referenceDigests", "outputDigest"],
        "properties": {
          "sceneId": {
            "type": "string",
            "pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$))[A-Za-z0-9가-힣](?:[A-Za-z0-9가-힣._ -]{0,126}[A-Za-z0-9가-힣_-])?$"
          },
          "promptDigest": { "$ref": "#/$defs/digest" },
          "referenceDigests": { "type": "array", "items": { "$ref": "#/$defs/digest" } },
          "outputDigest": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
