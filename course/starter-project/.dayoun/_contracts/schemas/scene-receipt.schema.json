{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dayoun.dev/contracts/scene-receipt.schema.json",
  "title": "Digest-bound scene renderer receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptVersion", "approvalEnvelopeDigest", "rendererVersion", "scenes"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "receiptVersion": { "const": "dayoun-scene-render-receipt-v2" },
    "approvalEnvelopeDigest": { "$ref": "#/$defs/digest" },
    "rendererVersion": { "const": "scene-deck-v2" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sceneId", "promptDigest", "referenceDigests", "outputDigest", "safeZone"],
        "properties": {
          "sceneId": {
            "type": "string",
            "pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$))[A-Za-z0-9가-힣](?:[A-Za-z0-9가-힣._ -]{0,126}[A-Za-z0-9가-힣_-])?$"
          },
          "promptDigest": { "$ref": "#/$defs/digest" },
          "referenceDigests": { "type": "array", "items": { "$ref": "#/$defs/digest" } },
          "outputDigest": { "$ref": "#/$defs/digest" },
          "safeZone": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "margin", "foregroundBox", "margins", "sha256"],
            "properties": {
              "status": { "const": "PASS" },
              "margin": { "const": 0.18 },
              "foregroundBox": {
                "type": "array",
                "prefixItems": [
                  { "type": "integer", "minimum": 0 },
                  { "type": "integer", "minimum": 0 },
                  { "type": "integer", "minimum": 1 },
                  { "type": "integer", "minimum": 1 }
                ],
                "items": false
              },
              "margins": {
                "type": "object",
                "additionalProperties": false,
                "required": ["left", "top", "right", "bottom"],
                "properties": {
                  "left": { "type": "number", "minimum": 0.175 },
                  "top": { "type": "number", "minimum": 0.175 },
                  "right": { "type": "number", "minimum": 0.175 },
                  "bottom": { "type": "number", "minimum": 0.175 }
                }
              },
              "sha256": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
