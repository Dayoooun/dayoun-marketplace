{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dayoun.dev/contracts/canonical.schema.json",
  "title": "Dayoun canonical business-plan payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "cycle",
    "facts",
    "evidence",
    "requirements",
    "decisions",
    "businessVerdicts",
    "contentSteps",
    "scope",
    "outputs",
    "rendererMode"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "projectId": { "type": "string", "minLength": 1 },
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cycleId", "currentRevision", "status"],
      "properties": {
        "cycleId": { "type": "string", "minLength": 1 },
        "currentRevision": { "type": "integer", "minimum": 1 },
        "status": { "const": "CURRENT" }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fact" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/decision" }
    },
    "businessVerdicts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/verdict" }
    },
    "contentSteps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contentStep" }
    },
    "scope": { "enum": ["QUICK", "SECTION", "FULL"] },
    "sectionId": { "type": "string", "minLength": 1 },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hwpx", "ppt"],
      "properties": {
        "hwpx": { "type": "boolean" },
        "ppt": { "type": "boolean" }
      }
    },
    "rendererMode": {
      "type": ["string", "null"],
      "enum": ["scene-deck", "image-first", null]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "scope": { "const": "SECTION" } } },
      "then": { "required": ["sectionId"] }
    },
    {
      "if": {
        "properties": {
          "outputs": {
            "properties": { "ppt": { "const": true } },
            "required": ["ppt"]
          }
        }
      },
      "then": {
        "properties": {
          "rendererMode": { "enum": ["scene-deck", "image-first"] }
        }
      },
      "else": {
        "properties": { "rendererMode": { "const": null } }
      }
    }
  ],
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "evidenceRefs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "claim": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "integer", "number", "boolean", "null"] },
        "unit": { "type": ["string", "null"] },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "locator"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "source": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "limitation": { "type": "string" }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "sourceRef", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string", "minLength": 1 },
        "status": { "enum": ["REQUIRED", "OPTIONAL", "NOT_APPLICABLE"] }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value", "approvedBy"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "value": {},
        "approvedBy": { "type": "string", "minLength": 1 }
      }
    },
    "contentStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidenceRefs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "status": { "enum": ["PASS", "BLOCK", "NOT_REVIEWED"] },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "PASS" } } },
          "then": { "properties": { "evidenceRefs": { "minItems": 1 } } }
        }
      ]
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "reason", "evidenceRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASS", "WARN", "BLOCK", "NOT_REVIEWED"] },
        "reason": { "type": "string", "minLength": 1 },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
