{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dayoun.dev/contracts/visible-text-manifest.schema.json",
  "title": "Approved visible-text oracle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "normalizerVersion", "mapperVersion", "entries", "relations"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "projectId": { "type": "string", "minLength": 1 },
    "normalizerVersion": { "const": "dayoun-visible-text-v1" },
    "mapperVersion": { "const": "dayoun-region-map-v1" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["textId", "briefIndex", "slide", "occurrence", "text", "tokenKind", "region"],
      "properties": {
        "textId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "briefIndex": { "type": "integer", "minimum": 1 },
        "slide": { "type": "integer", "minimum": 1 },
        "occurrence": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1 },
        "tokenKind": {
          "enum": ["heading", "body", "label", "value", "number", "date", "proper-noun", "evidence"]
        },
        "region": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "sourceRef": { "type": "string", "minLength": 1 }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationId", "kind", "geometry", "fromTextId", "toTextId"],
      "properties": {
        "relationId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["label-value", "evidence-claim", "date-event", "proper-noun-claim"] },
        "geometry": { "enum": ["same-row-left-to-right", "top-to-bottom", "adjacent"] },
        "fromTextId": { "type": "string", "minLength": 1 },
        "toTextId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
